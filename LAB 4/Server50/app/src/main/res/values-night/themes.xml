<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Server50" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:fontFamily">sans</item>

        <!-- Barra superior del sistema: fondo blanco como en pantalla_inicio.jpeg -->
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Evita que Material pinte la barra del sistema con el color morado por defecto -->
        <item name="colorPrimary">#0078C8</item>
        <item name="colorPrimaryDark">#FFFFFF</item>
        <item name="colorAccent">#0078C8</item>
    </style>

    <style name="Theme.Server50" parent="Base.Theme.Server50" />
</resources>
