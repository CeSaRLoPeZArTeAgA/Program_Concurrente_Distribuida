<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainVincular"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FF"
    android:fillViewport="true"
    tools:context=".VincularDispositivoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/txtTituloVincular"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_splash_header"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Dog Messenger"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtituloVincular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Vincular dispositivo"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDescripcionVincular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="6dp"
            android:text="Clonar chats\n\nUn desktop puede clonar el chat de un usuario móvil cuando el desktop emite un QR y el móvil lo lee.\n\nUn móvil puede clonar el chat de un usuario desktop cuando el móvil escanea el QR generado por el desktop.\n\nPresiona el botón para abrir la cámara y leer el QR de Dog Messenger."
            android:textColor="#222222"
            android:textSize="16sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <Button
            android:id="@+id/btnAbrirScanner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_splash_header"
            android:backgroundTint="@null"
            android:text="Vincular dispositivo"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRegresarDesdeVincular"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_splash_header"
            android:backgroundTint="@null"
            android:text="Regreso a pantalla principal"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
