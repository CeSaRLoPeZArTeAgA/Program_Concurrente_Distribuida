<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".SplashActivity">

    <LinearLayout
        android:id="@+id/layoutSplashContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/txtDogMessenger"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_splash_header"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Dog Messenger"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/imgDogMessenger"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:contentDescription="Dog Messenger"
                android:scaleType="fitCenter"
                android:src="@drawable/dog_messenger_shield" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
