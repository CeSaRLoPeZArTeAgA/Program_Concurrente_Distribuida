<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainScanQr"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    tools:context=".ScanQrActivity">

    <LinearLayout
        android:id="@+id/headerScanQr"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#070D10"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/btnVolverScan"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="42sp" />

        <TextView
            android:id="@+id/txtTituloScanQr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Escanea el código QR"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/txtAyudaScanQr"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:background="#070D10"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="Abre Dog Messenger de escritorio u otros dispositivos."
        android:textColor="#9EA4AA"
        android:textSize="18sp" />

    <FrameLayout
        android:id="@+id/contenedorCamaraQr"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#101820">

        <com.journeyapps.barcodescanner.DecoratedBarcodeView
            android:id="@+id/barcodeScanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/marcoScanner"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:background="#44FFFFFF" />

    </FrameLayout>

    <Button
        android:id="@+id/btnCancelarScan"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#070D10"
        android:text="Cancelar escaneo"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
